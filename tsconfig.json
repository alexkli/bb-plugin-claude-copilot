{
  "compilerOptions": {
    "strict": true,
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "lib": [
      "ES2022",
      "DOM"
    ],
    "types": [
      "node"
    ],
    "paths": {
      "@/*": [
        "./*"
      ]
    },
    "noEmit": true,
    "skipLibCheck": false
  },
  "include": [
    "server.ts",
    "host.ts",
    "app.tsx",
    "contract.ts",
    "dashboard.ts",
    "settings.ts",
    "reasoning.ts",
    "session-credits.tsx",
    "icon-paths.ts",
    "components",
    "lib",
    "hooks",
    "test",
    "vendor/provider-claude-code/server.ts",
    "vendor/provider-claude-code/src"
  ],
  "exclude": [
    "vendor/provider-claude-code/src/**/*.test.ts"
  ]
}
