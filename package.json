{
  "name": "bb-plugin-claude-copilot",
  "version": "0.1.3",
  "description": "Run Claude Code threads on your GitHub Copilot subscription, including the GPT, Gemini and Grok models Copilot offers.",
  "keywords": [
    "bb-plugin",
    "claude-code",
    "github-copilot",
    "copilot",
    "copilot-api",
    "provider"
  ],
  "license": "MIT",
  "author": "Alexander Klimetschek",
  "repository": {
    "type": "git",
    "url": "https://github.com/alexkli/bb-plugin-claude-copilot.git"
  },
  "type": "module",
  "engines": {
    "bb": ">=0.49",
    "bbPluginSdk": ">=0.6.132"
  },
  "bb": {
    "name": "Claude Copilot provider",
    "description": "Run Claude Code threads on your GitHub Copilot subscription, including the GPT, Gemini and Grok models Copilot offers.",
    "branding": {
      "icon": "./icons/claude-copilot.svg"
    },
    "server": "./server.ts",
    "host": "./host.ts",
    "app": "./app.tsx",
    "experimental_providers": [
      {
        "kind": "agent",
        "id": "claude-copilot",
        "displayName": "Claude Code (Copilot)"
      }
    ]
  },
  "scripts": {
    "build": "bb plugin build .",
    "typecheck": "tsc --noEmit -p .",
    "test": "vitest run --config vitest.config.ts",
    "sync-upstream": "scripts/sync-upstream.sh"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.318",
    "@get-bb/plugin-sdk": "0.6.132",
    "@jeffreycao/copilot-api": "2.9.3",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@radix-ui/react-slot": "^1.5.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^0.93.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "better-sqlite3": "12.11.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cron-parser": "^5.10.3",
    "hono": "4.13.16",
    "tailwind-merge": "^3.7.0",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vitest": "^4.1.12"
  }
}
